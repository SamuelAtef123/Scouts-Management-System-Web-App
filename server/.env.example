# Copy this file to .env and fill in the values.

NODE_ENV=development
PORT=5000
# Use your local time zone so "upcoming" and "past" events switch at local midnight.
TZ=Africa/Cairo

# MongoDB connection string (local MongoDB or MongoDB Atlas).
MONGO_URI=mongodb://127.0.0.1:27017/scouts

# Public DNS servers (Google, Cloudflare) for looking up the MongoDB Atlas address.
# Some home and mobile networks (e.g. some Egyptian providers) cannot answer these lookups,
# which shows as "querySrv/queryTxt ETIMEOUT". Remove the line to use the network's own DNS.
DNS_SERVERS=8.8.8.8,1.1.1.1

# A long random string (at least 32 characters; the server refuses weak ones in production).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Where the React app runs in development (for CORS). In production: the app's own https address.
CLIENT_ORIGIN=http://localhost:5173

# How many reverse proxies sit in front of the app: 0 when Node is reached directly,
# 1 on hosts like Render or Railway. A wrong value lets attackers dodge the sign-in limit.
TRUST_PROXY=0

MAX_UPLOAD_MB=25

# The password of a new member when the Database member leaves it empty (default scouts123).
# DEFAULT_MEMBER_PASSWORD=scouts123

# First accounts created by "npm run seed".
# The first account (the Group Leader). Use the real person's full name: Home greets them by first name.
SEED_ADMIN_NAME=Group Leader
SEED_ADMIN_USERNAME=leader
SEED_ADMIN_PASSWORD=
# Optional here (asked on first sign-in otherwise), but needed for "Forgot password?" before then.
SEED_ADMIN_EMAIL=
# The first Database / Attendance member (privileged). Only Database members can add members,
# so this person adds everyone else from the Members page. Use their real name and username, and put
# the username in src/attendanceAssignments.js if they take attendance for a kadr.
SEED_DB_NAME=
SEED_DB_USERNAME=
SEED_DB_PASSWORD=
SEED_DB_EMAIL=

# ---------- Emails (new events, tasks assigned, file reviews, "Forgot password?") ----------
# Sent from the group's Gmail through the Gmail API, with the Google OAuth client below. The refresh token
# (GOOGLE_OAUTH_REFRESH_TOKEN) must allow both Google Drive and "gmail.send" (see the README). Without a
# token nothing is sent: each email is printed in the server log instead. EMAIL=off turns sending off.
# EMAIL=off
EMAIL_FROM_NAME=Light of the World Scouts
# Only when the sending Gmail is a different account from the Drive one:
# GMAIL_REFRESH_TOKEN=
# The site's public https address for the links in emails (defaults to CLIENT_ORIGIN).
# APP_URL=https://your-app.onrender.com

# ---------- Google Drive (task materials) ----------
# The id of the Drive folder that will hold all materials
# (the part after /folders/ in the folder's URL).
GOOGLE_DRIVE_FOLDER_ID=
# Optional: the folder where uploads wait until a reviewer approves them. Keep it private (not shared
# with the group). Leave empty to use a private "Scouts - waiting for review" folder in the Google
# account's own Drive (OAuth), or "_Waiting for review" inside the folder above (service account).
GOOGLE_DRIVE_REVIEW_FOLDER_ID=
# Optional: where `npm run backup` saves database backups. Leave empty for a private
# "Scouts - backups" folder in the Google account's own Drive (OAuth).
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
# Automatic backup: a dated file (scouts-backup-automatic-<date>.json.gz) in that folder every
# AUTO_BACKUP_DAYS, keeping the newest AUTO_BACKUP_KEEP. On by default only when NODE_ENV=production;
# set AUTO_BACKUP=on or off to change it.
# AUTO_BACKUP=on
AUTO_BACKUP_DAYS=30
AUTO_BACKUP_KEEP=3

# Option A (recommended for a normal Google account):
# OAuth client of a Google Cloud project + a refresh token of the account that owns the folder.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Option B (Google Workspace with Shared Drives):
# a service account key. The folder must be inside a Shared Drive the service account is a member of.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# ...or the key JSON itself on one line:
GOOGLE_SERVICE_ACCOUNT_JSON=

# Leave all Google values empty in development: files are then saved in server/uploads.
